#!/usr/bin/env python3
"""Open a NEW window wearing a random machine — font included.

`retro random` (the shell function) repaints the window you are already in:
OSC 4/10/11/12 for the palette, then the banner. That is the whole of what a
running terminal can be told to do. There is no escape sequence for "change
your font", because the cell grid is fixed when the window is created — so a
random MU-TH-UR arrives in whatever face the launching profile specified, and
the machine is only half worn.

The font has to be chosen BEFORE the window exists, which means asking the
terminal to create one from a named profile. That is what this does, using the
same AppleScript path tools/retro-demo already relies on.

    tools/retro-random                     # any of the 47
    tools/retro-random --group sci-fi      # just one pack
    tools/retro-random --terminal ghostty  # Ghostty instead of iTerm2
    tools/retro-random --print             # name only; open nothing

To wear one at every iTerm2 launch, drop a one-line caller into iTerm2's
AutoLaunch folder (see --help epilogue) rather than setting
RETRO_RANDOM_ON_START=1, which is the in-place repaint and cannot carry a font.
"""
from __future__ import annotations

import argparse
import random
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

import build_profiles as bp  # noqa: E402
from build_ghostty import GROUPS, kebab  # noqa: E402


def pick(group: str) -> dict:
    pool = []
    for profiles, tag in GROUPS:
        if group in ("all", tag):
            pool.extend(profiles)
    if not pool:
        sys.exit(f"retro-random: no profiles in group {group!r}")
    return random.choice(pool)


def open_iterm2(profile: dict) -> None:
    name = profile["Name"]
    if not shutil.which("osascript"):
        sys.exit("retro-random: osascript not found (macOS only)")
    quoted = '"' + name.replace("\\", "\\\\").replace('"', '\\"') + '"'
    # Address iTerm by BUNDLE ID, not by name: the app is "iTerm" on disk while
    # everyone calls it iTerm2, and `tell application "iTerm2"` fails. This is
    # the same form tools/retro-demo uses.
    script = (
        'tell application id "com.googlecode.iterm2"\n'
        "  activate\n"
        f"  create window with profile {quoted}\n"
        "end tell"
    )
    r = subprocess.run(["osascript", "-e", script], text=True, capture_output=True)
    if r.returncode != 0:
        # The commonest cause is a profile iTerm2 has not loaded yet, which is
        # a build problem, not a launch problem -- say so rather than the raw
        # AppleScript error.
        sys.exit(f"retro-random: iTerm2 refused {name!r} — run ./install.sh first\n"
                 f"  {r.stderr.strip()}")


def open_ghostty(profile: dict) -> None:
    for tag_profiles, tag in GROUPS:
        if profile in tag_profiles:
            slug = f"{tag}-{kebab(profile['Name'])}"
            break
    else:
        sys.exit(f"retro-random: {profile['Name']} is in no group")
    cfg = Path.home() / ".config/ghostty/retro" / slug
    if not cfg.exists():
        sys.exit(f"retro-random: no Ghostty config {cfg} — run build_ghostty.py")
    subprocess.run(["open", "-na", "Ghostty", "--args", f"--config-file={cfg}"])


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Open a new terminal window wearing a random retro machine.",
        epilog=(
            "Random machine at every iTerm2 launch — put this in\n"
            "~/Library/Application Support/iTerm2/Scripts/AutoLaunch/random.py:\n"
            "  import subprocess\n"
            f"  subprocess.run(['{ROOT}/tools/retro-random'])\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--group", default="all",
                    choices=["all"] + [t for _, t in GROUPS])
    ap.add_argument("--terminal", default="iterm2", choices=["iterm2", "ghostty"])
    ap.add_argument("--print", dest="only_print", action="store_true",
                    help="print the chosen machine and exit")
    a = ap.parse_args()

    p = pick(a.group)
    print(f"{p['Name']}  ·  {p['Normal Font']}")
    if a.only_print:
        return
    (open_ghostty if a.terminal == "ghostty" else open_iterm2)(p)


if __name__ == "__main__":
    main()
